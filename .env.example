# Copy to .env and fill in. .env is gitignored.
# LLM provider configuration (any provider works; mock mode runs without keys)
LLM_PROVIDER=mock          # mock | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Kaggle (only needed for the one-time raw download)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Paths (relative to repo root)
DATA_DIR=data
RAW_DATA_FILE=data/raw/twitter_customer_support.csv
CACHE_DIR=data/cache
GOLD_DIR=data/gold
REPORTS_DIR=reports
DOCS_DIR=docs

# Sampling / eval
SAMPLE_SEED=42
SAMPLE_SIZE=200000
TRAIN_FRACTION=0.7
VAL_FRACTION=0.1
GOLDEN_SIZE=200

# Thresholds (tuned on validation split; see reports/threshold_sweep.md)
INTENT_CONFIDENCE_THRESHOLD=0.55
RETRIEVAL_SIMILARITY_THRESHOLD=0.55
GROUNDING_STRENGTH_THRESHOLD=0.6